---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

// The post's ogImage doubles as its thumbnail; no image, no thumbnail.
const { title, description, ogImage, ...props } = data;

const thumbnailClass =
  "aspect-[1.91/1] w-24 shrink-0 self-center rounded-md object-cover sm:w-40";
---

<li class="my-4">
  <article
    class="border-border hover:border-accent/60 relative flex gap-4 rounded-lg border p-4 transition-colors sm:p-5"
  >
    <div class="min-w-0 flex-1">
      <a
        href={getPostUrl(id, filePath, Astro.currentLocale)}
        class:list={[
          "text-accent inline-block text-lg font-medium",
          "decoration-dashed underline-offset-4 hover:underline",
          "focus-visible:no-underline focus-visible:underline-offset-0",
          // the whole card is clickable; the link text stays the title
          "after:absolute after:inset-0",
        ]}
      >
        <Heading transition:name={toTransitionName(id)}>
          {title}
        </Heading>
      </a>
      <Datetime {...props} />
      <p class="mt-1 line-clamp-2">{description}</p>
    </div>
    {
      ogImage &&
        (typeof ogImage === "string" ? (
          <img src={ogImage} alt="" loading="lazy" class={thumbnailClass} />
        ) : (
          <Image src={ogImage} alt="" width={320} class={thumbnailClass} />
        ))
    }
  </article>
</li>
