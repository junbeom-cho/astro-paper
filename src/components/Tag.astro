---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li>
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    transition:name={tag}
    class:list={[
      "bg-accent/10 text-accent inline-block rounded-full underline-offset-2 hover:underline",
      { "px-2.5 py-0.5 text-sm": size === "sm" },
      { "px-3 py-1 text-base": size === "lg" },
    ]}
  >
    #{tagName}
  </a>
</li>
