---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { Image } from "astro:assets";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import profileImage from "@/assets/images/about/capybara-profile.jpg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import CategoryIcon from "@/components/CategoryIcon.astro";
import Tag from "@/components/Tag.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getUniqueTags } from "@/utils/getUniqueTags";
import {
  getCategoryIcon,
  getCategoryTree,
  getPostsInCategory,
  parseCategory,
} from "@/utils/categories";
import { getPostUrl } from "@/utils/getPostPaths";
import { getSchemaRefs } from "@/utils/structuredData";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;

// Latest posts listed in each category box, and tags shown at most
const CATEGORY_POSTS = 3;
const MAX_TAGS = 20;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
const aboutPath = getRelativeLocaleUrl(locale, "about");
// Same look as the category links on post pages
const introLink =
  "text-accent decoration-accent/40 hover:decoration-accent underline underline-offset-4";

const categoryUrl = (...slugs: string[]) =>
  getRelativeLocaleUrl(locale, `categories/${slugs.join("/")}/`);

// One box per top-level category: its subcategories and latest posts
const categories = getCategoryTree(posts).map(parent => ({
  ...parent,
  href: categoryUrl(parent.slug),
  children: parent.children.map(child => ({
    ...child,
    href: categoryUrl(parent.slug, child.slug),
  })),
  posts: getPostsInCategory(sortedPosts, [parent.slug])
    .slice(0, CATEGORY_POSTS)
    .map(post => ({
      title: post.data.title,
      href: getPostUrl(post, locale),
      icon: getCategoryIcon(parseCategory(post.data.category)),
    })),
}));

// Most used first; ties stay in name order
const tags = getUniqueTags(posts)
  .sort((tagA, tagB) => tagB.count - tagA.count)
  .slice(0, MAX_TAGS);

// Section heading with a link to the full list on the far side
const sectionHead = "flex items-baseline justify-between gap-4";
const sectionTitle = "text-2xl font-semibold tracking-wide";
const moreLink =
  "text-muted-foreground hover:text-accent flex shrink-0 items-center gap-1 text-sm";

const { homeUrl, websiteId, author } = getSchemaRefs(Astro.site, locale);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": websiteId,
  name: config.site.title,
  url: homeUrl,
  // Posts are written in Korean while the UI stays in site.lang
  inLanguage: "ko",
  author,
};
---

<Layout>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>

  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout divide-border my-1 divide-y"
  >
    <h1 class="sr-only">{config.site.title}</h1>

    {/* Example intro: who writes here and about what. Edit the copy freely */}
    <section
      id="intro"
      lang="ko"
      class="flex items-start gap-4 pt-8 pb-6 sm:items-center sm:gap-6"
    >
      <Image
        src={profileImage}
        alt=""
        width={160}
        loading="eager"
        class="border-border size-16 shrink-0 rounded-full border object-cover sm:size-20"
      />
      <div class="space-y-3">
        <p>안녕하세요, 기록하는 개발자 조준범입니다.</p>
        <p>
          일하며 부딪힌 문제와 해결 과정, 일하고 공부하면서 생긴 의문을 탐구한
          내용, 그리고 회고를 기록합니다. 더 자세한 소개는{" "}
          <a href={aboutPath} class={introLink}>About 페이지</a>에 있습니다.
        </p>
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section id="featured" class="pt-8 pb-6">
          <h2 class={sectionTitle}>{t.home.featured}</h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-8 pb-6">
          <div class={sectionHead}>
            <h2 class={sectionTitle}>{t.home.recentPosts}</h2>
            <a href={getRelativeLocaleUrl(locale, "posts")} class={moreLink}>
              {t.home.allPosts}
              <IconArrowRight
                aria-hidden="true"
                class="inline-block size-4 rtl:-rotate-180"
              />
            </a>
          </div>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      categories.length > 0 && (
        <section id="categories" class="pt-8 pb-6">
          <div class={sectionHead}>
            <h2 class={sectionTitle}>{t.nav.categories}</h2>
            <a
              href={getRelativeLocaleUrl(locale, "categories")}
              class={moreLink}
            >
              {t.home.allCategories}
              <IconArrowRight
                aria-hidden="true"
                class="inline-block size-4 rtl:-rotate-180"
              />
            </a>
          </div>
          {/* One column on phones, two from sm; minmax(0) columns let titles truncate */}
          <ul
            class:list={[
              "mt-4 grid grid-cols-1 gap-4",
              { "sm:grid-cols-2": categories.length > 1 },
            ]}
          >
            {categories.map(category => (
              <li class="border-border rounded-lg border p-4">
                <h3 class="text-lg font-semibold">
                  <a
                    href={category.href}
                    class="hover:text-accent focus-visible:text-accent flex items-center gap-2"
                  >
                    <CategoryIcon icon={category.icon} class="text-accent" />
                    <span lang="ko" class="truncate">
                      {category.name}
                    </span>
                    <span class="text-muted-foreground text-sm font-normal">
                      ({category.count})
                    </span>
                  </a>
                </h3>
                {category.children.length > 0 && (
                  <ul class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-sm">
                    {category.children.map(child => (
                      <li>
                        <a
                          href={child.href}
                          class="text-muted-foreground hover:text-accent flex items-center gap-1 py-0.5"
                        >
                          <CategoryIcon icon={child.icon} />
                          <span lang="ko">{child.name}</span>
                          <span>({child.count})</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
                <ul class="border-border mt-3 border-t pt-2">
                  {category.posts.map(post => (
                    <li>
                      <a
                        href={post.href}
                        class="group hover:text-accent flex items-center gap-2 py-1"
                      >
                        <CategoryIcon
                          icon={post.icon}
                          class="text-muted-foreground"
                        />
                        {/* Underline the title only, not the icon */}
                        <span
                          lang="ko"
                          class="truncate decoration-dashed underline-offset-4 group-hover:underline"
                        >
                          {post.title}
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      tags.length > 0 && (
        <section id="tags" class="pt-8 pb-6">
          <div class={sectionHead}>
            <h2 class={sectionTitle}>{t.nav.tags}</h2>
            <a href={getRelativeLocaleUrl(locale, "tags")} class={moreLink}>
              {t.home.allTags}
              <IconArrowRight
                aria-hidden="true"
                class="inline-block size-4 rtl:-rotate-180"
              />
            </a>
          </div>
          <ul class="mt-4 flex flex-wrap gap-2">
            {tags.map(({ tag, tagName, count }) => (
              <Tag {tag} {tagName} {count} size="sm" />
            ))}
          </ul>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
