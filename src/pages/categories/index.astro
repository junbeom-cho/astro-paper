---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { getCategoryTree } from "@/utils/categories";
import { useTranslations } from "@/i18n";
import config from "@/config";

const categories = getCategoryTree(await getCollection("posts"));

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const linkClass =
  "hover:text-accent focus-visible:text-accent underline decoration-dashed underline-offset-4";
---

<Layout title={`${t.pages.categoriesTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.categoriesTitle} pageDesc={t.pages.categoriesDesc}>
    <ul class="space-y-4">
      {
        categories.map(parent => (
          <li>
            <a
              href={getRelativeLocaleUrl(locale, `categories/${parent.slug}/`)}
              class:list={[linkClass, "text-lg font-medium"]}
            >
              {parent.name}
            </a>
            <span class="text-muted-foreground ms-1">({parent.count})</span>
            {parent.children.length > 0 && (
              <ul class="border-border ms-1 mt-2 space-y-1.5 border-s ps-4">
                {parent.children.map(child => (
                  <li>
                    <a
                      href={getRelativeLocaleUrl(
                        locale,
                        `categories/${parent.slug}/${child.slug}/`
                      )}
                      class={linkClass}
                    >
                      {child.name}
                    </a>
                    <span class="text-muted-foreground ms-1 text-sm">
                      ({child.count})
                    </span>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </Main>

  <Footer />
</Layout>
