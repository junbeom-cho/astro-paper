---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Datetime from "@/components/Datetime.astro";
import Footer from "@/components/Footer.astro";
import IconFolder from "@/assets/icons/IconFolder.svg";
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import {
  getCategoryTree,
  getPostsInCategory,
  parseCategory,
} from "@/utils/categories";
import { getPostUrl } from "@/utils/getPostPaths";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const posts = getSortedPosts(await getCollection("posts"));

// Each top-level category with its own posts, then each subcategory with its posts
const categories = getCategoryTree(posts).map(parent => ({
  ...parent,
  posts: posts.filter(({ data }) => {
    const levels = parseCategory(data.category);
    return levels.length === 1 && levels[0].slug === parent.slug;
  }),
  children: parent.children.map(child => ({
    ...child,
    posts: getPostsInCategory(posts, [parent.slug, child.slug]),
  })),
}));

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const categoryUrl = (...slugs: string[]) =>
  getRelativeLocaleUrl(locale, `categories/${slugs.join("/")}/`);

// Tree layout: each list draws the vertical guide (border-s), each item a
// short horizontal branch (before:) into it.
const branchList = "border-foreground/20 ms-3 mt-2 space-y-3 border-s ps-6";
const branchItem =
  "before:border-foreground/20 relative before:absolute before:top-3 before:-inset-s-6 before:w-4 before:border-t";
// Post rows keep the date beside the title when there is room
const postItem = `${branchItem} flex flex-wrap items-center gap-x-3`;
// Folders fold with <details>; the chevron points right when closed, down when open
const summary = "cursor-pointer list-none [&::-webkit-details-marker]:hidden";
const chevron =
  "text-muted-foreground shrink-0 rotate-180 transition-transform";
---

<Layout title={`${t.pages.categoriesTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.categoriesTitle} pageDesc={t.pages.categoriesDesc}>
    <ul class="space-y-10">
      {
        categories.map(parent => (
          <li>
            <details open class="group/parent">
              <summary class={summary}>
                <h2 class="flex items-center gap-2 text-xl font-semibold">
                  <IconFolder class="text-accent size-6 shrink-0" />
                  <a
                    href={categoryUrl(parent.slug)}
                    class="hover:text-accent focus-visible:text-accent"
                  >
                    {parent.name}
                  </a>
                  <span class="text-muted-foreground text-base font-normal">
                    ({parent.count})
                  </span>
                  <IconChevronLeft
                    aria-hidden="true"
                    class:list={[
                      chevron,
                      "size-5 group-open/parent:-rotate-90",
                    ]}
                  />
                </h2>
              </summary>

              <ul class={branchList}>
                {parent.posts.map(post => (
                  <li class={postItem}>
                    <a
                      href={getPostUrl(post.id, post.filePath, locale)}
                      class="text-foreground hover:text-accent font-medium decoration-dashed underline-offset-4 hover:underline"
                    >
                      {post.data.title}
                    </a>
                    <Datetime {...post.data} />
                  </li>
                ))}

                {parent.children.map(child => (
                  <li class={branchItem}>
                    <details class="group/child">
                      <summary class={summary}>
                        <h3 class="flex items-center gap-2 text-lg font-semibold">
                          <IconFolder class="text-accent size-5 shrink-0" />
                          <a
                            href={categoryUrl(parent.slug, child.slug)}
                            class="hover:text-accent focus-visible:text-accent"
                          >
                            {child.name}
                          </a>
                          <span class="text-muted-foreground text-sm font-normal">
                            ({child.count})
                          </span>
                          <IconChevronLeft
                            aria-hidden="true"
                            class:list={[
                              chevron,
                              "size-4 group-open/child:-rotate-90",
                            ]}
                          />
                        </h3>
                      </summary>
                      <ul class={branchList}>
                        {child.posts.map(post => (
                          <li class={postItem}>
                            <a
                              href={getPostUrl(post.id, post.filePath, locale)}
                              class="text-foreground hover:text-accent font-medium decoration-dashed underline-offset-4 hover:underline"
                            >
                              {post.data.title}
                            </a>
                            <Datetime {...post.data} />
                          </li>
                        ))}
                      </ul>
                    </details>
                  </li>
                ))}
              </ul>
            </details>
          </li>
        ))
      }
    </ul>
  </Main>

  <Footer />
</Layout>
