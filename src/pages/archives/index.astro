---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getCollection } from "astro:content";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { getPostUrl } from "@/utils/getPostPaths";
import { postFilter } from "@/utils/postFilter";
import { useTranslations } from "@/i18n";
import config from "@/config";

dayjs.extend(utc);
dayjs.extend(timezone);

const locale = Astro.currentLocale ?? config.site.lang;

// Redirect to 404 page if `showArchives` config is false
const notFoundUrl = getRelativeLocaleUrl(locale, "404");
if (!config.features.showArchives && notFoundUrl) {
  return Astro.rewrite(notFoundUrl);
}

const t = useTranslations(locale);

// Newest first, with dates in the post's (or site's) timezone so the grouping
// matches the date shown on the post page regardless of the build machine.
const posts = (await getCollection("posts"))
  .filter(postFilter)
  .map(post => ({
    post,
    date: dayjs(post.data.pubDatetime).tz(
      post.data.timezone ?? config.site.timezone
    ),
  }))
  .sort((a, b) => b.date.valueOf() - a.date.valueOf());

// Map.groupBy keeps insertion order, so years and months stay newest first
const years = [...Map.groupBy(posts, ({ date }) => date.year())].map(
  ([year, yearPosts]) => ({
    year,
    count: yearPosts.length,
    months: [...Map.groupBy(yearPosts, ({ date }) => date.month())],
  })
);

const monthFormatter = new Intl.DateTimeFormat(locale, { month: "long" });
const monthName = (month: number) =>
  monthFormatter.format(new Date(2000, month, 1));

// Timeline: the year list draws the line (border-s); markers are positioned
// onto it from each item's start edge (ps-6 + 1px border).
const monthMarker =
  "before:border-accent before:bg-background relative before:absolute before:top-1.5 before:-inset-s-[32.5px] before:size-4 before:rounded-full before:border-2";
const postMarker =
  "before:bg-accent before:ring-background relative before:absolute before:top-2 before:-inset-s-[29.5px] before:size-2.5 before:rounded-full before:ring-4";
---

<Layout title={`${t.pages.archivesTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.archivesTitle} pageDesc={t.pages.archivesDesc}>
    {
      years.map(({ year, count, months }) => (
        <section class="mb-12">
          <h2 class="text-2xl font-bold">
            {year}
            <sup class="text-muted-foreground ms-0.5 text-sm font-normal">
              {count}
            </sup>
          </h2>
          <ol class="border-foreground/20 ms-2 mt-4 space-y-8 border-s ps-6">
            {months.map(([month, monthPosts]) => (
              <li>
                <h3 class:list={["text-lg font-semibold", monthMarker]}>
                  {monthName(month)}
                  <sup class="text-muted-foreground ms-0.5 text-xs font-normal">
                    {monthPosts.length}
                  </sup>
                </h3>
                <ol class="mt-3 space-y-3">
                  {monthPosts.map(({ post, date }) => (
                    <li
                      class:list={[
                        "flex flex-wrap items-baseline gap-x-4",
                        postMarker,
                      ]}
                    >
                      <time
                        datetime={date.toISOString()}
                        class="text-muted-foreground w-14 shrink-0 text-sm tabular-nums"
                      >
                        {date.format("MMM D")}
                      </time>
                      <a
                        href={getPostUrl(post.id, post.filePath, locale)}
                        class="text-accent font-medium decoration-dashed underline-offset-4 hover:underline"
                      >
                        {post.data.title}
                      </a>
                    </li>
                  ))}
                </ol>
              </li>
            ))}
          </ol>
        </section>
      ))
    }
  </Main>

  <Footer />
</Layout>
