---
import type { MarkdownHeading } from "astro";
import { useTranslations } from "@/i18n";

type Props = {
  headings: MarkdownHeading[];
};

const t = useTranslations(Astro.currentLocale);

// h2-h3 only; skip the in-content "## Table of contents" heading and the
// sr-only footnotes heading generated by remark-rehype.
const items = Astro.props.headings.filter(
  ({ depth, slug, text }) =>
    depth <= 3 &&
    slug !== "footnote-label" &&
    !/^table[ -]of[ -]contents?$/i.test(text)
);
---

{
  items.length > 0 && (
    <aside
      class="absolute inset-s-full top-0 ms-4 hidden h-full w-56 xl:block"
      data-pagefind-ignore
    >
      <nav
        aria-label={t.post.onThisPage}
        class="sticky top-8 max-h-[calc(100svh-4rem)] overflow-y-auto text-sm"
      >
        <p class="text-foreground mb-2 font-semibold">{t.post.onThisPage}</p>
        <ul class="border-border space-y-1.5 border-s ps-3">
          {items.map(({ depth, slug, text }) => (
            <li class:list={[{ "ps-3": depth === 3 }]}>
              <a
                href={`#${slug}`}
                class="text-foreground/70 hover:text-accent wrap-break-word"
              >
                {text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>
  )
}
