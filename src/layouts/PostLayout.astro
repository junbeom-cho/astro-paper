---
import Layout from "./Layout.astro";
import { getSchemaRefs } from "@/utils/structuredData";
import config from "@/config";
import "katex/dist/katex.min.css";

type Props = {
  title?: string;
  /** Post title without the site title suffix, for BlogPosting.headline */
  headline?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  tags?: string[];
  category?: string;
};

const { site } = config;

const {
  title,
  headline,
  description,
  ogImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  tags,
  category,
} = Astro.props;

const locale = Astro.currentLocale ?? site.lang;
const pageURL = canonicalURL ?? new URL(Astro.url.pathname, Astro.site).href;
const { author, websiteId } = getSchemaRefs(Astro.site, locale);
// A post never edited since publishing was last modified when published
const lastModified = modDatetime ?? pubDatetime;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: headline ?? title ?? site.title,
  description,
  url: pageURL,
  mainEntityOfPage: pageURL,
  image: ogImage,
  ...(pubDatetime && { datePublished: pubDatetime.toISOString() }),
  ...(lastModified && { dateModified: lastModified.toISOString() }),
  // Posts are written in Korean, like the lang="ko" on the article
  inLanguage: "ko",
  keywords: tags,
  articleSection: category,
  author: [author],
  isPartOf: { "@id": websiteId },
};
---

<Layout {title} {description} {ogImage} canonicalURL={pageURL} ogType="article">
  <Fragment slot="head">
    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>

  <slot />
</Layout>
