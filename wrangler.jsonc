{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard
  "name": "astro-paper",
  "compatibility_date": "2026-10-01",
  // No "main": an assets-only Worker serving the static build
  "assets": {
    "directory": "./dist",
    // Serve dist/404.html with a 404 status (default "none" sends an empty 404).
    // html_handling defaults to "auto-trailing-slash", which matches Astro's
    // directory output: /posts/foo -> 307 -> /posts/foo/
    "not_found_handling": "404-page"
  }
  // No "routes": the custom domain (blog.techbara.dev) is added once in the
  // dashboard; deploys leave it alone.
}
